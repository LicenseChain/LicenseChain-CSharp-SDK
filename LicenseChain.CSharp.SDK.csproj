<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>LicenseChain.CSharp.SDK</PackageId>
    <Version>1.0.2</Version>
    <Authors>LicenseChain Team</Authors>
    <Company>LicenseChain</Company>
    <Product>LicenseChain C# SDK</Product>
    <Description>Official LicenseChain C# SDK for license management and validation</Description>
    <Copyright>Copyright © LicenseChain LLC 2024</Copyright>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageProjectUrl>https://licensechain.app</PackageProjectUrl>

    <RepositoryUrl>https://github.com/LicenseChain/LicenseChain-CSharp-SDK</RepositoryUrl>
    <PackageTags>license;validation;management;api;sdk</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Initial release of LicenseChain C# SDK</PackageReleaseNotes>
    <AssemblyTitle>LicenseChain C# SDK</AssemblyTitle>
    <AssemblyDescription>Official LicenseChain C# SDK for license management and validation</AssemblyDescription>
    <AssemblyCompany>LicenseChain</AssemblyCompany>
    <AssemblyProduct>LicenseChain C# SDK</AssemblyProduct>
    <AssemblyCopyright>Copyright © LicenseChain LLC 2024</AssemblyCopyright>

    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="examples/**/*.cs" />
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>

</Project>
